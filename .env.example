# ============================================================
# Petora API · Variables de entorno
# ============================================================
# 1. Copia este archivo como .env:
#      cp .env.example .env
#    En Windows (PowerShell):
#      Copy-Item .env.example .env
# 2. Completa cada valor. Las variables se cargan con ConfigModule
#    (src/app.module.ts) y son obligatorias salvo que se indique lo contrario.
# 3. No subas el archivo .env real al repositorio; solo este ejemplo debe versionarse.
# ============================================================

# --- Base de datos PostgreSQL ---
# Completa estos valores antes de ejecutar docker compose.
# Host donde se ejecuta PostgreSQL. Ejemplo local: localhost.
DB_HOST=

# Puerto de PostgreSQL. Debe coincidir con el puerto publicado por docker-compose.yaml. Ejemplo: 5432.
DB_PORT=

# Usuario de PostgreSQL. Con docker-compose.yaml se usa postgres.
DB_USER=

# Contraseña de PostgreSQL. docker-compose.yaml la reutiliza como POSTGRES_PASSWORD.
DB_PASSWORD=

# Nombre de la base de datos. docker-compose.yaml lo reutiliza como POSTGRES_DB. Ejemplo: petora.
DB_NAME=

# --- Aplicación ---
# Puerto HTTP de la API. Si se omite la variable, main.ts usa 3000. Ejemplo: 3000.
PORT=

# Entorno de ejecución. Usa "prod" para habilitar SSL en la conexión a PostgreSQL;
# cualquier otro valor (por ejemplo, "dev" o vacío) lo desactiva.
# No uses "prod" con el PostgreSQL local de docker-compose.yaml, que no tiene SSL.
STAGE=

# --- Cloudinary (subida de imágenes) ---
# Credenciales del panel de Cloudinary (Product Environment Credentials).
# Las tres variables son obligatorias: el servicio falla al iniciar si falta alguna.
# Nombre de la nube (Cloud name).
CLOUDINARY_CLOUD_NAME=

# Clave API (API key).
CLOUDINARY_API_KEY=

# Secreto API (API secret). No lo compartas ni lo subas al repositorio.
CLOUDINARY_API_SECRET=

# --- Autenticación ---
# Clave secreta para firmar y verificar los JWT (obligatoria).
# Usa una cadena larga y aleatoria. Puedes generarla con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET_KEY=
