# Copia este archivo como .env y completa cada valor.
# No subas el archivo .env real al repositorio.

# --- Base de datos PostgreSQL ---
DB_HOST=                                        # Host de la base de datos (por ejemplo, localhost)
DB_PORT=                                        # Puerto de PostgreSQL (por ejemplo, 5432)
DB_USER=                                        # Usuario de la base de datos
DB_PASSWORD=                                    # Contraseña de la base de datos
DB_NAME=                                        # Nombre de la base de datos

# --- Aplicación ---
PORT=                                           # Puerto HTTP de la API (3000 por defecto)

# --- Cloudinary (subida de imágenes) ---
CLOUDINARY_CLOUD_NAME=                          # Nombre de la nube de Cloudinary
CLOUDINARY_API_KEY=                             # Clave API de Cloudinary
CLOUDINARY_API_SECRET=                          # Secreto API de Cloudinary

# --- Autenticación ---
JWT_SECRET_KEY=                                 # Clave secreta para firmar los tokens JWT
